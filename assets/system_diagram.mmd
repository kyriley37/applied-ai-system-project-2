flowchart TD
    USER([" User\nNatural Language Input\ne.g. warm soulful Sunday feel "])

    USER --> PARSER

    subgraph CLAUDE_IN ["Claude API — Intent Parser"]
        PARSER["Parse intent\nNatural language → structured\nfrequency profile + cultural query"]
    end

    subgraph RAG ["RAG — Cultural Knowledge Base"]
        KB[("cultural_kb.json\nBlack American Music Heritage\nJazz · Gospel · Soul · Funk\nHip-Hop · R&B · Reggae")]
        RETRIEVER["Retrieve cultural context\nGenre lineage · Frequency signatures\nSonic DNA"]
        PARSER --> RETRIEVER
        KB --> RETRIEVER
    end

    subgraph ENGINE ["Recommender Engine"]
        FREQ["Frequency Profile Mapper\nfreq_prefs → audio feature weights\nsub_bass · warmth · groove · vocal"]
        SCORER["score_song + recommend_songs\nWeighted feature scoring\nacross 10+ audio attributes"]
        DIVERSE["Diversity Penalty\nArtist + genre spread"]
        CATALOG[("songs.csv\nSong Catalog")]
        RETRIEVER --> FREQ
        FREQ --> SCORER
        CATALOG --> SCORER
        SCORER --> DIVERSE
    end

    subgraph CLAUDE_OUT ["Claude API — Explainer"]
        EXPLAIN["Generate response\nTop-K results + cultural context\n→ natural language explanation"]
    end

    DIVERSE --> EXPLAIN
    RETRIEVER --> EXPLAIN

    subgraph OUTPUT ["Output"]
        RESULT([" Ranked Recommendations\nSong list + cultural explanation\nWhy this frequency resonates "])
    end

    EXPLAIN --> RESULT

    subgraph RELIABILITY ["Reliability & Observability"]
        LOGGER["Logger\nTracks retrieval decisions\nscoring rationale · API calls"]
        TESTER["Test Harness\nRuns profiles × strategies\nChecks consistency + precision"]
        GUARDRAIL["Guardrails\nFallback if Claude fails\nInput validation"]
    end

    SCORER --> LOGGER
    EXPLAIN --> LOGGER
    TESTER -->|"automated runs"| SCORER

    subgraph HUMAN ["Human-in-the-Loop"]
        REVIEW([" Human Review\nInspect logs · validate results\nadjust cultural_kb.json "])
    end

    LOGGER --> REVIEW
    RESULT --> REVIEW

